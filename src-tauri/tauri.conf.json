{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chikku Parser",
  "version": "0.3.49",
  "identifier": "com.abinjacob.chikku-parser",
  "build": {
    "beforeDevCommand": "npm run tauri:renderer:watch",
    "devUrl": "http://localhost:5181",
    "beforeBuildCommand": "npm run tauri:renderer:build",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost http: https:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost; worker-src 'self'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4QzM2QTIyMzYwRjRFNwpSV1RuOUdBam9qYU1DY0lvemRPTWlTbVNGVXJYVTllZnhOdy93bTNPTi9nODk5L09sdERUK1E4Ygo=",
      "endpoints": [
        "https://github.com/aj4abinjacob/chikku_parser/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "fileAssociations": [
      {
        "ext": ["csv"],
        "name": "Comma Separated Values",
        "role": "Viewer"
      },
      {
        "ext": ["tsv"],
        "name": "Tab Separated Values",
        "role": "Viewer"
      },
      {
        "ext": ["json", "jsonl", "ndjson"],
        "name": "JSON File",
        "role": "Viewer"
      },
      {
        "ext": ["md", "markdown"],
        "name": "Markdown File",
        "role": "Viewer"
      },
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "role": "Viewer"
      },
      {
        "ext": ["parquet"],
        "name": "Parquet File",
        "role": "Viewer"
      },
      {
        "ext": ["xlsx", "xls"],
        "name": "Excel Workbook",
        "role": "Viewer"
      }
    ],
    "category": "DeveloperTool",
    "publisher": "Abin Jacob",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
